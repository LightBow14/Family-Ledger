# Copy this to .env.local for local development, or set these as
# Environment Variables in your Vercel project settings for deployment.

# From Supabase: Project -> Connect -> use the "Transaction pooler" URI
# (port 6543) — this is the serverless-friendly connection string.
DATABASE_URL=postgres://postgres.xxxxxxxx:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# Any long random string. Generate one with:
#   openssl rand -hex 32
# This signs login sessions -- keep it secret, and don't change it once
# people have logged in, or everyone gets logged out.
SESSION_SECRET=replace-with-a-long-random-string
